# Run mode: demo | lite
APP_MODE=lite

# SQLite paths
APP_DB_PATH=data/app.db
CHECKPOINT_DB_PATH=data/checkpoints.db

# LLM model keys (used by bindings)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
